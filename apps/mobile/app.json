{
  "expo": {
    "name": "QuitLoop",
    "slug": "quitloop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/quitloop-emblem.png",
    "splash": {
      "image": "./assets/brand/quitloop-emblem.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gixza.quitloop"
    },
    "android": {
      "package": "com.gixza.quitloop",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/quitloop-emblem.png",
        "backgroundColor": "#07111F"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "660a3288-b829-49cc-85b5-338b1fd4f426"
      }
    },
    "owner": "joicy"
  }
}
