# Copy to .env and adjust for local development.
# These values are local defaults, not production secrets.

POSTGRES_USER=quitloop
POSTGRES_PASSWORD=quitloop
POSTGRES_DB=quitloop
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Used by the API container. Host=postgres is the Compose service name.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=quitloop;Username=quitloop;Password=quitloop

# Deployed-environment defaults for the UK MVP.
# Core business logic must not assume these values.
REGIONAL_DEFAULT_COUNTRY_CODE=GB
REGIONAL_DEFAULT_CURRENCY_CODE=GBP
REGIONAL_DEFAULT_LANGUAGE_CODE=en-GB
REGIONAL_DEFAULT_TIME_ZONE=Europe/London
REGIONAL_DEFAULT_UNIT_SYSTEM=metric
